{
  // Configurazione Cloudflare Workers (file statici) del sito pubblicato su www.lamagiostra.it.
  // Il nome deve coincidere con il progetto creato su Cloudflare (lamagiostra-v2).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lamagiostra-v2",
  "compatibility_date": "2026-10-01",
  // Programma lato server (solo per /api/*, ad esempio /api/instagram). Il resto sono i file del sito.
  "main": "worker/index.ts",
  // Ogni giorno alle 4: rinnova il token di Instagram (vale 60 giorni).
  "triggers": { "crons": ["0 4 * * *"] },
  // Il sito risponde solo da lamagiostra.it: niente indirizzi pubblici *.workers.dev (né di produzione né di anteprima).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Le richieste /api/* vanno al programma; tutte le altre ai file del sito.
    "run_worker_first": ["/api/*"],
    // Ogni indirizzo (es. /fornitori) apre l'app; la pagina "non trovata" la mostra l'app stessa.
    "not_found_handling": "single-page-application"
  },
  // Sito di prova v3 (ramo "v3"): progetto Cloudflare "lamagiostra-v3", indirizzo *.workers.dev.
  // Su Cloudflare il comando di pubblicazione è: npx wrangler deploy --env v3
  "env": {
    "v3": {
      "name": "lamagiostra-v3",
      "workers_dev": true,
      "preview_urls": false,
      // Senza collegamento a Instagram, il sito di prova mostra un testo di esempio.
      "vars": { "AMBIENTE": "prova" }
    }
  }
}
