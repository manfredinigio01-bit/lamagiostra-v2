# Copia questo file in ".env" (in locale) oppure inserisci lo stesso nome nelle
# variabili d'ambiente del servizio di hosting (Cloudflare Pages: Settings -> Variables).

# Indirizzo definitivo del sito, senza "/" finale (es. https://www.lamagiostra.it).
# Serve per sitemap, anteprime social e indirizzo canonico. Compilalo appena hai scelto il dominio.
VITE_SITE_URL=https://www.esempio.it
